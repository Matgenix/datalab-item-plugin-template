from importlib.metadata import entry_points
{%- if include_custom_panel %}
from pathlib import Path
{%- endif %}

from {{ package_name }} import __version__
from {{ package_name }}.models import {{ item_class_name }}


def test_version():
    assert __version__


def test_entry_point_is_registered():
    """The entry point is how datalab discovers this plugin at startup."""
    eps = [ep for ep in entry_points(group="pydatalab.item_types") if ep.name == "{{ item_type_name }}"]
    assert len(eps) == 1
    assert eps[0].load() is {{ item_class_name }}


def test_model_registers_with_datalab():
    """Mirror what `pydatalab.apps.load_item_plugins` does at server startup;
    this also validates all `datalab_*` schema hints on the model."""
    from pydatalab.models import ITEM_MODELS, register_item_model

    register_item_model({{ item_class_name }})
    assert ITEM_MODELS["{{ item_type_name }}"] is {{ item_class_name }}


def test_model_round_trip():
    item = {{ item_class_name }}(item_id="test-item-1")
    assert item.type == "{{ item_type_name }}"
    assert {{ item_class_name }}(**item.model_dump()).item_id == "test-item-1"
{%- if include_custom_panel %}


def test_panel_follows_naming_convention():
    """`invoke dev.collect-plugin-panels` looks for `webapp/<ClassName>Panel.vue`
    inside the package directory."""
    import {{ package_name }}

    package_dir = Path({{ package_name }}.__file__).parent
    assert (package_dir / "webapp" / "{{ item_class_name }}Panel.vue").is_file()
