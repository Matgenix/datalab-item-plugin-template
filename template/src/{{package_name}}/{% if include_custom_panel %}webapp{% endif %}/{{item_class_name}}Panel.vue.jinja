<!--
  Custom panel for the `{{item_type_name}}` item type.

  Discovery convention: datalab's `invoke dev.collect-plugin-panels` copies any
  `webapp/<ModelClassName>Panel.vue` found in this package into the webapp and
  wires it up for the corresponding item type. Keep the file name in sync with
  the model class name.

  IMPORTANT: because this panel exists, datalab does NOT auto-render the model's
  custom fields — this component is responsible for rendering ALL of them.

  The webapp components imported below (`ItemSelect`, `FormattedItemName`,
  `TooltipIcon`, ...) resolve against the datalab webapp source at build time.
-->
<template>
  <div class="container {{ item_type_name | replace('_', '-') }}-panel mt-3">
    <div class="plugin-card">
      <div class="plugin-card-header d-flex align-items-center justify-content-between">
        <span>{{ item_class_name | regex_replace('(?<!^)(?=[A-Z])', ' ') }}</span>
        <TooltipIcon text="TODO: describe this panel for your users." />
      </div>
      <div class="plugin-card-body">
        <!-- An item reference: shows the linked item once set, a search box otherwise. -->
        <div class="form-group">
          <label class="mb-1">Example reference</label>
          <div v-if="itemData.example_reference" class="input-group">
            <div class="form-control ref-display">
              <FormattedItemName
                :item_id="itemData.example_reference.item_id"
                :item-type="itemData.example_reference.type"
                :name="itemData.example_reference.name || ''"
                enable-click
                enable-modified-click
              />
            </div>
            <div class="input-group-append">
              <button
                type="button"
                class="btn btn-outline-secondary"
                title="Clear"
                @click="update('example_reference', null)"
              >
                <font-awesome-icon :icon="['fas', 'times']" />
              </button>
            </div>
          </div>
          <ItemSelect
            v-else
            :model-value="itemData.example_reference"
            :types-to-query="['starting_materials', 'samples']"
            @update:model-value="update('example_reference', $event)"
          />
        </div>

        <!-- A canonical value with its presentation unit stored separately. -->
        <div class="form-group">
          <label class="mb-1">Example quantity</label>
          <div class="input-group quantity-group">
            <input
              type="number"
              step="any"
              min="0"
              class="form-control"
              :value="exampleQuantityDisplayValue"
              @change="updateExampleQuantity($event.target.value)"
            />
            <select
              class="form-control unit-select"
              :value="exampleQuantityDisplayUnit"
              @change="update('example_quantity_display_unit', $event.target.value)"
            >
              <option value="g">g</option>
              <option value="mg">mg</option>
            </select>
          </div>
        </div>

        <!-- An enum rendered as a dropdown. -->
        <div class="form-group">
          <label class="mb-1">Example choice</label>
          <select
            class="form-control"
            :value="itemData.example_choice || ''"
            @change="update('example_choice', $event.target.value || null)"
          >
            <option value="">—</option>
            <option value="one">one</option>
            <option value="two">two</option>
            <option value="three">three</option>
          </select>
        </div>

        <!-- Free text. -->
        <div class="form-group mb-0">
          <label class="mb-1">Example notes</label>
          <textarea
            class="form-control"
            rows="3"
            :value="itemData.example_notes || ''"
            @change="update('example_notes', $event.target.value || null)"
          />
        </div>
      </div>
    </div>
  </div>
</template>

<script>
import ItemSelect from "@/components/ItemSelect.vue";
import TooltipIcon from "@/components/TooltipIcon.vue";
import FormattedItemName from "@/components/FormattedItemName.vue";

export default {
  name: "{{item_class_name}}Panel",
  components: { ItemSelect, TooltipIcon, FormattedItemName },
  props: {
    item_id: { type: String, required: true },
    itemType: { type: String, required: true },
  },
  computed: {
    // The item document lives in the central store; edits are committed back to
    // it and saved by the standard item-page save flow.
    itemData() {
      return this.$store.state.all_item_data[this.item_id] || {};
    },
    exampleQuantityDisplayUnit() {
      return this.itemData.example_quantity_display_unit || "g";
    },
    exampleQuantityDisplayValue() {
      const canonicalGrams = this.itemData.example_quantity;
      if (canonicalGrams === null || canonicalGrams === undefined) return "";
      return this.exampleQuantityDisplayUnit === "mg" ? canonicalGrams * 1000 : canonicalGrams;
    },
  },
  methods: {
    update(field, value) {
      this.$store.commit("updateItemData", {
        item_id: this.item_id,
        item_data: { [field]: value },
      });
    },
    updateExampleQuantity(raw) {
      const displayed = raw === "" ? null : Number(raw);
      const canonicalGrams =
        displayed === null || this.exampleQuantityDisplayUnit === "g"
          ? displayed
          : displayed * 0.001;
      this.$store.commit("updateItemData", {
        item_id: this.item_id,
        item_data: {
          example_quantity: canonicalGrams,
          example_quantity_display_unit: this.exampleQuantityDisplayUnit,
        },
      });
    },
  },
};
</script>

<style scoped>
.{{ item_type_name | replace('_', '-') }}-panel {
  padding-bottom: 1rem;
}
.plugin-card {
  border: 1px solid #dee2e6;
  border-radius: 0.375rem;
}
.plugin-card-header {
  font-size: 1rem;
  font-weight: 600;
  color: #495057;
  padding: 0.65rem 1rem;
  background-color: #f8f9fa;
  border-bottom: 1px solid #dee2e6;
  border-radius: 0.375rem 0.375rem 0 0;
}
.plugin-card-body {
  padding: 1rem;
}
.ref-display {
  display: flex;
  align-items: center;
  background-color: #f8f9fa;
  color: inherit;
  text-decoration: none;
  flex: 1;
}
.unit-select {
  max-width: 6rem;
  flex: 0 0 auto;
}
</style>
